{
  "manifest_version": 3,
  "name": "YouTube 視聴済み管理",
  "version": "0.2.0",
  "description": "YouTubeの動画サムネイルに視聴済み/未視聴バッジを表示し、動画ページのボタンや自動判定で視聴状態を管理します。",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "src/shared/constants.js",
        "src/shared/videoId.js",
        "src/shared/storage.js",
        "src/content/domObserver.js",
        "src/content/thumbnailOverlay.js",
        "src/content/videoPageButton.js",
        "src/content/playbackTracker.js",
        "src/content/content-script.js"
      ],
      "css": ["src/styles/overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
